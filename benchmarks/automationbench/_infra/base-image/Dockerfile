# Shared base image for every converted AutomationBench task.
#
# Build context is the repository root (so both vendor/ and engine/ are visible):
#     docker build -f base-image/Dockerfile -t automationbench-harbor-base:2 .
#
# Per-task images are one `FROM` plus a `COPY task/` of a few kilobytes of JSON,
# so 606 tasks share this ~500 MB layer stack instead of rebuilding it each time.
# The same image backs the verifier container, which therefore grades with a
# provably untouched copy of the rubric.
FROM python:3.13-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ABCTL_TASK_CONFIG=/app/task/task_config.json

# bash+coreutils for the agent's shell; curl/procps/nodejs are what harbor's
# installed agents (claude-code) bootstrap themselves with -- preinstalled here so
# agent setup is a download rather than an apt transaction, and cannot fail on a
# slow mirror. jq is a convenience for the agent when reading tool output.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        bash ca-certificates curl procps jq git && \
    rm -rf /var/lib/apt/lists/*

# AutomationBench's own runtime deps. Pinned: the tool JSON schemas the agent is
# shown are generated by agents.function_schema, so its version is part of the
# task contract.
RUN pip install --no-cache-dir \
    "pydantic==2.13.4" \
    "openai==3.3.0" \
    "openai-agents==0.22.0" \
    "mcp==1.19.0" \
    "uvicorn==0.38.0"

# The simulated world: schema + ~550 tool functions + API routers + rubric.
# Vendored WITHOUT automationbench/domains -- that package holds the assertion
# answer keys for all 806 upstream tasks and must never be readable by an agent.
COPY vendor /opt/automationbench-engine
RUN pip install --no-cache-dir --no-deps /opt/automationbench-engine && \
    rm -rf /opt/automationbench-engine

# The shell bridge (`abctl`) and the grader used by tests/verify.py.
COPY engine /opt/abctl
RUN pip install --no-cache-dir --no-deps /opt/abctl && \
    rm -rf /opt/abctl

# Fail the build, not the first task run, if the vendored subset is incomplete.
RUN python3 -c "\
from automationbench.tools import ALL_TOOLS; \
from automationbench.tools.api import API_TOOLS; \
from automationbench.rubric import partial_credit; \
from automationbench.rubric.registry import AssertionRegistry; \
import automationbench.rubric.assertions; \
import abctl.cli, abctl.oracle; \
assert len(ALL_TOOLS) > 500, len(ALL_TOOLS); \
assert len(AssertionRegistry._handlers) > 500, len(AssertionRegistry._handlers); \
print('tools', len(ALL_TOOLS), 'api', len(API_TOOLS), 'assertions', len(AssertionRegistry._handlers))" && \
    python3 -c "import automationbench.domains" 2>/dev/null && \
        (echo 'FATAL: answer keys (automationbench.domains) leaked into the image' >&2; exit 1) || true

# For MCP-interface tasks: an unprivileged user for the agent and a private
# directory for the seed and the world. `[agent] user = "agent"` in task.toml makes
# harbor exec the agent as this user (verified: the agent phase reports
# uid=1000(agent)), while the container's own PID 1 stays root and can run the world
# service. CLI-interface tasks ignore all of this and keep running as root.
RUN useradd -m -s /bin/bash agent && \
    install -d -m 0700 -o root -g root /srv/world
COPY engine/ab-init /usr/local/bin/ab-init
COPY engine/ab-harden /usr/local/bin/ab-harden
RUN chmod 0755 /usr/local/bin/ab-init /usr/local/bin/ab-harden

RUN mkdir -p /app /logs/verifier && chown agent:agent /app
WORKDIR /app
